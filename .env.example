# Settings of the Dominik AI chatbot. Copy this file to .env.local and fill
# in the values; .env.local is never committed (see .gitignore). On Vercel,
# add the same names under Settings > Environment Variables.
# Step-by-step guide (in Croatian): docs/chatbot-postavljanje.md

# Gemini API key from Google AI Studio. Server only: never add the
# NEXT_PUBLIC_ prefix, or Next.js would put it into the browser code.
GEMINI_API_KEY=
# Optional. Default: gemini-3.1-flash-lite
GEMINI_MODEL=

# Upstash Redis: conversations (48 hours) and the message limits.
# The Vercel integration may create KV_REST_API_URL and KV_REST_API_TOKEN
# instead; the code reads either pair. Leave empty locally to keep
# everything in memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# A long random secret used to hash IP addresses. Required in production.
IP_HASH_SALT=

# Cloudflare Turnstile. The site key is public, the secret key is not.
# Leave both empty to turn the check off (for example locally).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Gmail account that sends the emails, its app password (not the normal
# password), and the address that receives the conversations.
GMAIL_USER=
GMAIL_APP_PASSWORD=
CHAT_NOTIFY_EMAIL=

# A long random secret. Vercel sends it to the daily job (/api/chat/cron).
CRON_SECRET=

# Optional. false turns the chatbot off.
CHAT_ENABLED=
# Optional. More addresses the chat may be used from, comma separated
# (for example a custom domain: https://www.example.com).
CHAT_ALLOWED_ORIGINS=

# Optional limits. Defaults: 10, 40, 20 and 300.
CHAT_LIMIT_PER_10_MIN=
CHAT_LIMIT_PER_DAY=
CHAT_LIMIT_PER_CONVERSATION=
CHAT_LIMIT_SITE_PER_DAY=
